<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fadjar Fish Farm - Pusat Aquaculture & Budidaya Ikan Hias Profesional</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 antialiased">

    <!-- Header / Navbar -->
    <header class="fixed top-0 w-full bg-slate-900/90 backdrop-blur-md z-50 border-b border-cyan-900/50">
        <div class="max-w-7xl mx-mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between mx-auto">
            <div class="flex items-center gap-3">
                <div class="bg-cyan-500 p-2.5 rounded-xl shadow-lg shadow-cyan-500/30">
                    <i class="fa-solid font-bold fa-fish-fins text-2xl text-slate-950"></i>
                </div>
                <div>
                    <span class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-emerald-400 bg-clip-text text-transparent">FADJAR</span>
                    <span class="text-xs block font-semibold tracking-widest text-slate-400">FISH FARM</span>
                </div>
            </div>
            
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <a href="#about" class="hover:text-cyan-400 transition-colors">Tentang Kami</a>
                <a href="#services" class="hover:text-cyan-400 transition-colors">Keahlian & Layanan</a>
                <a href="#breeding" class="hover:text-cyan-400 transition-colors">Pemijahan & Kultur</a>
                <a href="#contact" class="hover:text-cyan-400 transition-colors">Konsultasi</a>
            </nav>

            <a href="#contact" class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-slate-950 font-semibold px-5 py-2.5 rounded-full transition-all shadow-md shadow-cyan-500/20">
                <i class="fa-solid fa-comments"></i> Konsultasi Ahli
            </a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/40 via-slate-900 to-slate-900"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-950/80 border border-cyan-500/30 text-cyan-400 text-xs font-semibold mb-6">
                <i class="fa-solid fa-flask text-xs"></i> Solusi Aquaculture Berbasis Sains & Presisi
            </span>
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
                Inovasi Budidaya Ikan Hias, <span class="bg-gradient-to-r from-cyan-400 to-emerald-400 bg-clip-text text-transparent">Manajemen Kualitas Air</span> & Pemijahan Unggul
            </h1>
            <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto font-light">
                Pendekatan ilmiah dalam kontrol parameter akuatik, nitrifikasi mikrobiologi, formulasi pakan pencerah warna, dan penanganan penyakit ikan secara terukur.
            </p>
            <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
                <a href="#services" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-8 py-3.5 rounded-xl transition-all shadow-lg shadow-cyan-500/25">
                    Jelajahi Layanan
                </a>
                <a href="#breeding" class="border border-slate-700 hover:border-cyan-500 text-slate-300 hover:text-white font-medium px-8 py-3.5 rounded-xl transition-all">
                    Teknik Pemijahan
                </a>
            </div>
        </div>
    </section>

    <!-- Stats / Highlights -->
    <section class="border-y border-slate-800 bg-slate-950/50 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div>
                <h3 class="text-3xl font-bold text-cyan-400">99%</h3>
                <p class="text-xs text-slate-400 mt-1">Keberhasilan Penetasan Telur</p>
            </div>
            <div>
                <h3 class="text-3xl font-bold text-emerald-400">0.0 mg/L</h3>
                <p class="text-xs text-slate-400 mt-1">Target Bebas Amonia (NH3)</p>
            </div>
            <div>
                <h3 class="text-3xl font-bold text-cyan-400">100%</h3>
                <p class="text-xs text-slate-400 mt-1">Nutrisi Organik & Kultur Hidup</p>
            </div>
            <div>
                <h3 class="text-3xl font-bold text-emerald-400">24/7</h3>
                <p class="text-xs text-slate-400 mt-1">Monitoring Parameter Kimia Air</p>
            </div>
        </div>
    </section>

    <!-- Services / Focus Area -->
    <section id="services" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-bold text-white">Fokus & Keahlian Utama</h2>
            <p class="text-slate-400 mt-2">Penerapan standar akuakultur profesional untuk performa optimal ikan hias Anda.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Card 1 -->
            <div class="bg-slate-800/50 border border-slate-700/50 p-6 rounded-2xl hover:border-cyan-500/50 transition-all">
                <div class="w-12 h-12 bg-cyan-500/10 text-cyan-400 rounded-xl flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-vial"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Kimia & Parameter Air</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Keseimbangan presisi pH, GH/KH (kesadahan), TDS, suhu, serta eliminasi Amonia & Nitrit berbasis perhitungan rasio biologi air.
                </p>
            </div>

            <!-- Card 2 -->
            <div class="bg-slate-800/50 border border-slate-700/50 p-6 rounded-2xl hover:border-emerald-500/50 transition-all">
                <div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-xl flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-bacteria"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Mikrobiologi & Siklus Nitrogen</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Pengolahan limbah organik menggunakan kolonisasi bakteri nitrifikasi (<em>Nitrosomonas</em> & <em>Nitrobacter</em>) serta aplikasi probiotik aktif.
                </p>
            </div>

            <!-- Card 3 -->
            <div class="bg-slate-800/50 border border-slate-700/50 p-6 rounded-2xl hover:border-cyan-500/50 transition-all">
                <div class="w-12 h-12 bg-cyan-500/10 text-cyan-400 rounded-xl flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Pemijahan & Pembesaran Larva</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Manipulasi suhu, pemicu alami, perawatan *yolk sac*, penanganan telur dari jamur, hingga optimalisasi rasio kelangsungan hidup burayak (SR).
                </p>
            </div>

            <!-- Card 4 -->
            <div class="bg-slate-800/50 border border-slate-700/50 p-6 rounded-2xl hover:border-emerald-500/50 transition-all">
                <div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-xl flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-bowl-food"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Formulasi & Kultur Pakan Hidup</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Kultur pakan alami (*Artemia, Infusoria, Daphnia, Moina*) serta kecukupan nutrisi (protein, asam lemak HUFA/PUFA, astaxanthin) untuk warna & imun.
                </p>
            </div>

            <!-- Card 5 -->
            <div class="bg-slate-800/50 border border-slate-700/50 p-6 rounded-2xl hover:border-cyan-500/50 transition-all">
                <div class="w-12 h-12 bg-cyan-500/10 text-cyan-400 rounded-xl flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-kit-medical"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Diagnosis & Penyakit Ikan</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Penanganan tepat sasaran terhadap infeksi bakteri, parasit (*White Spot, Dactylogyrus*), jamur (*Saprolegnia*), serta karantina medis.
                </p>
            </div>

            <!-- Card 6 -->
            <div class="bg-slate-800/50 border border-slate-700/50 p-6 rounded-2xl hover:border-emerald-500/50 transition-all">
                <div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-xl flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Desain Sistem Filtrasi Custom</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Perancangan sistem filter mekanis, biologis, dan kimiawi (Sump, RAS / Recirculating Aquaculture System) sesuai kapasitas populasi kolam.
                </p>
            </div>
        </div>
    </section>

    <!-- Breeding & Water Tech Section -->
    <section id="breeding" class="py-20 bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <span class="text-cyan-400 text-sm font-semibold uppercase tracking-wider">Standar Operasional Breeder</span>
                    <h2 class="text-3xl font-bold text-white mt-2">Metode Pemijahan Terintegrasi & Pengelolaan Larva</h2>
                    <p class="text-slate-400 mt-4 leading-relaxed">
                        Di Fadjar Fish Farm, kami mengombinasikan faktor biokimia air dan pemenuhan nutrisi mikro untuk memastikan angka penetasan telur maksimum dan pembentukan imun burayak yang kuat sejak fase penyerapan kantung kuning telur (*yolk sac*).
                    </p>
                    
                    <ul class="mt-6 space-y-4">
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-cyan-400 mt-1"></i>
                            <div>
                                <strong class="text-white">Stimulasi Parameter Lingkungan:</strong>
                                <p class="text-slate-400 text-sm">Pengaturan pergantian air dingin/hangat dan pencahayaan untuk memicu hormon reproduksi alami.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-cyan-400 mt-1"></i>
                            <div>
                                <strong class="text-white">Proteksi Anti-Jamur Organik:</strong>
                                <p class="text-slate-400 text-sm">Penggunaan agen alami dan dosis Methylene Blue / Acriflavine yang aman untuk mencegah *Saprolegnia* pada telur.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-cyan-400 mt-1"></i>
                            <div>
                                <strong class="text-white">Skema Transition Feeding:</strong>
                                <p class="text-slate-400 text-sm">Transisi pakan dari Infusoria/Rotifera ke Nauplii Artemia yang dikaya kan (*enrichment*) vitamin C & E.</p>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Interactive / Visual Box -->
                <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl shadow-2xl relative">
                    <h3 class="text-lg font-bold text-white mb-4 border-b border-slate-800 pb-3">
                        <i class="fa-solid fa-chart-line text-emerald-400 mr-2"></i> Parameter Target Optimal Air (Umum)
                    </h3>
                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between items-center bg-slate-800/40 p-3 rounded-lg">
                            <span class="text-slate-300">pH Air</span>
                            <span class="font-mono text-cyan-400 font-bold">6.5 - 7.5 (Stabil)</span>
                        </div>
                        <div class="flex justify-between items-center bg-slate-800/40 p-3 rounded-lg">
                            <span class="text-slate-300">Amonia Free (NH3)</span>
                            <span class="font-mono text-emerald-400 font-bold">&lt; 0.02 mg/L</span>
                        </div>
                        <div class="flex justify-between items-center bg-slate-800/40 p-3 rounded-lg">
                            <span class="text-slate-300">Nitrit (NO2)</span>
                            <span class="font-mono text-emerald-400 font-bold">0.0 mg/L</span>
                        </div>
                        <div class="flex justify-between items-center bg-slate-800/40 p-3 rounded-lg">
                            <span class="text-slate-300">TDS (Total Dissolved Solids)</span>
                            <span class="font-mono text-cyan-400 font-bold">80 - 150 ppm (Breeding)</span>
                        </div>
                        <div class="flex justify-between items-center bg-slate-800/40 p-3 rounded-lg">
                            <span class="text-slate-300">Suhu Air</span>
                            <span class="font-mono text-cyan-400 font-bold">27°C - 29°C</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact & Consultation Form -->
    <section id="contact" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-br from-slate-900 via-cyan-950/30 to-slate-900 border border-cyan-800/30 rounded-3xl p-8 md:p-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <div>
                    <h2 class="text-3xl font-bold text-white">Konsultasi Masalah Akuarium & Budidaya</h2>
                    <p class="text-slate-400 mt-3 text-sm leading-relaxed">
                        Mengalami masalah air keruh, amonia melonjak, ikan sakit/gantung diri, atau kegagalan pemijahan? Hubungi tim Fadjar Fish Farm untuk mendapatkan diagnosis teknis dan solusi cepat.
                    </p>

                    <div class="mt-8 space-y-4">
                        <div class="flex items-center gap-4 text-slate-300">
                            <div class="w-10 h-10 bg-cyan-500/10 text-cyan-400 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <span class="text-sm">Fadjar Fish Farm Facility, Indonesia</span>
                        </div>
                        <div class="flex items-center gap-4 text-slate-300">
                            <div class="w-10 h-10 bg-emerald-500/10 text-emerald-400 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <span class="text-sm">+62 812-XXXX-XXXX (WhatsApp Consultation)</span>
                        </div>
                        <div class="flex items-center gap-4 text-slate-300">
                            <div class="w-10 h-10 bg-cyan-500/10 text-cyan-400 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <span class="text-sm">info@fadjarfishfarm.com</span>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Nama Lengkap</label>
                        <input type="text" placeholder="Masukkan nama Anda" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Jenis Masalah / Pertanyaan</label>
                        <select class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500">
                            <option>Manajemen Parameter Air & Amonia</option>
                            <option>Konsultasi Pemijahan / Indukan</option>
                            <option>Formulasi & Kultur Pakan Hidup</option>
                            <option>Penanganan Ikan Sakit / Diagnosis</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Pesan / Detail Kasus</label>
                        <textarea rows="4" placeholder="Jelaskan volume kolam, nilai pH/TDS saat ini, atau gejala ikan..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-500"></textarea>
                    </div>
                    <button type="button" class="w-full bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-slate-950 font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-cyan-500/20">
                        Kirim Pesan Konsultasi
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-8 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4">
            <p>&copy; 2026 Fadjar Fish Farm. Spesialis Aquaculture, Parameter Air & Pemijahan Ikan Hias.</p>
        </div>
    </footer>

</body>
</html>
